# ===== LLM（默认使用本机 Ollama）=====
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_JUDGE_MODEL=qwen3.5:4b
OLLAMA_FAST_MODEL=qwen3.5:4b

# ===== 记忆与上下文预算（token）=====
# 应与实际服务端模型窗口一致；所有模型输出上限取原配置与预留的较小值。
# 4096/2048 可能放不下固定system/schema而明确拒绝；4096/1024仍需按部署模型验证。
CHAT_CONTEXT_WINDOW_TOKENS=8192
CHAT_OUTPUT_RESERVE_TOKENS=2048
CHAT_HISTORY_MAX_TOKENS=3072
CHAT_SUMMARY_MAX_TOKENS=768
CHAT_MEMORY_MAX_TOKENS=768
# 可选：生成模型对应的本地 HuggingFace tokenizer 目录，不会自动下载。
# 未配置时使用 UTF-8 字节数作保守 token 估算，消息协议另留余量。
# 本地tokenizer仅用于generation；独立router/fast/judge始终用保守估算，非provider usage。
CHAT_TOKENIZER_PATH=

# 测评默认跟随本地裁判。设为 aliyun 后仅测评使用下列云端配置，
# 不影响应用生成、记忆和 RAG 相关性评分；测评内容会发送到云端。
EVALUATION_PROVIDER=
# 云端测评使用 GRADE_MODEL（例如 qwen3.7-flash），未设置则回退 FAST_MODEL / MODEL。
# ARK_API_KEY 是历史变量名，也用于阿里云兼容接口密钥。
# LLM_PROVIDER=ark 时应用整体仍可使用下列兼容配置。
ARK_API_KEY=
MODEL=
GRADE_MODEL=
FAST_MODEL=
BASE_URL=

# 本地密集向量（langchain_huggingface / sentence-transformers）
EMBEDDING_MODEL= #BAAI/bge-m3
EMBEDDING_DEVICE= #cpu
DENSE_EMBEDDING_DIM= #1024

# ===== Rerank (可选，不配则自动降级) =====
RERANK_MODEL= #jina-reranker-v3
RERANK_BINDING_HOST= #https://api.jina.ai/v1/rerank
RERANK_API_KEY= #jina_
# 相关性阈值：空值禁用，分别作用于当前实际使用的评分器；不使用 RRF 分数。
# 外部模型分数尺度不同，请先验证再填写；LLM 取值 0..10，6 可作未校准试验值。
RERANK_MIN_SCORE=
LLM_RERANK_MIN_SCORE=
# 启用后允许少于 Top-K、不回填未评分项；保持评分原文，不自动合并未评分父块。

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 原生 BM25 需要 Milvus 2.5+；旧集合须先按 docs/BM25.md 迁移
MILVUS_COLLECTION=embeddings_collection

# ===== LangSmith 追踪 (可选) =====
LANGCHAIN_API_KEY= #your_langsmith_api_key
LANGCHAIN_PROJECT= #starmew-dev
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_DEBUG=false

# ===== 上传任务与失败恢复（单后端进程，默认均在项目 data/ 内）=====
# UPLOAD_JOB_DB_PATH=/persistent/data/upload_jobs.sqlite3
# 启动锁自动使用上述路径加 .backend.lock；共享索引的进程必须使用同一任务库。
# DOCUMENT_TRANSACTION_DIR=/persistent/data/document_transactions
# 仅用于旧格式恢复/离线工具；原生 BM25 不读取此状态文件
# BM25_STATE_PATH=/persistent/data/bm25_state.json

# ===== 本地故障定位（取得进程锁后自动启动，无外部通知）=====
# 诊断表复用 UPLOAD_JOB_DB_PATH；日志每文件 10 MiB，保留 5 份轮转文件
# DIAGNOSTICS_LOG_DIR=/persistent/data/logs
# DIAGNOSTICS_RETENTION_DAYS=30
# DIAGNOSTICS_MODEL_SLOW_SECONDS=60
# DIAGNOSTICS_FIRST_ANSWER_SECONDS=60
# DIAGNOSTICS_QUEUE_SLOW_SECONDS=120
# DIAGNOSTICS_SEARCH_SLOW_SECONDS=10
# DIAGNOSTICS_RERANK_SLOW_SECONDS=15
# DIAGNOSTICS_STAGE_SLOW_SECONDS=300

# Agent 有界默认预算；真实延迟/质量仍需按部署模型验收，不保证硬墙钟上限。
AGENT_MAX_DECISIONS=4
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_KB_CALLS=2
AGENT_MAX_RETRIEVAL_CALLS=4
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_FINAL_RESERVE_SECONDS=20
# deadline协作式传递到实际调用；取消/退出需排空真实线程，不能硬杀未响应线程。
# 可选工具决策模型，继承当前provider、base_url及凭证；空值维持生成模型。
AGENT_ROUTER_MODEL=
# 精确“你好”且无有效历史/摘要/待办/记忆时直接生成；收益未验证前保持关闭。
AGENT_DIRECT_CHAT_ENABLED=false
# 持久MemoryUpdateJob与回答同事务入库，后台失败不改变已成功回答。
# 没有独立worker暂停开关；正常停止后端会停止领任务并排空当前线程，任务保留。
# 查询/failed-only重试及存储回滚要求见docs/MEMORY_SYSTEM.md。
